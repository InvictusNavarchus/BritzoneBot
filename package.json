{
	"type": "module",
	"name": "britzone-bot",
	"version": "3.2.0",
	"description": "Discord bot designed to manage breakout rooms for voice channels",
	"main": "dist/index.js",
	"scripts": {
		"clean": "rimraf dist",
		"build:info": "bun scripts/generateBuildInfo.ts",
		"build": "bun run clean && bun run build:info && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"start": "NODE_ENV=production bun dist/index.js",
		"deploy": "bun dist/deployCommandsLocal.js",
		"dev": "bun run build:info && bun --watch src/index.ts",
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "bun run build:info && tsc --noEmit",
		"test": "bun run build:info && vitest run",
		"test:watch": "bun run build:info && vitest",
		"knip": "knip",
		"release": "release-it"
	},
	"dependencies": {
		"@discordjs/builders": "^1.14.1",
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@types/node": "^26.2.0",
		"knip": "^6.32.2",
		"lefthook": "^2.1.10",
		"release-it": "^21.0.2",
		"rimraf": "^6.1.3",
		"tsc-alias": "^1.9.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
